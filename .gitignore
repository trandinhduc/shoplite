# dependencies
node_modules/

# next.js
.next/
# thư mục build của server E2E thứ hai (NEXT_DIST_DIR)
.next-e2e/
.next-smoke/
out/

# build output
build/
*.tsbuildinfo
# next dev/build tự sinh lại, nội dung đổi theo chế độ chạy
next-env.d.ts

# testing
coverage/
playwright-report/
test-results/

# env files (secrets)
.env
.env.*
!.env.example

# logs
*.log

# OS
.DS_Store

# local storage (đơn hàng JSON)
storage/

# claude code: commit cấu hình dự án (ghi đè `.claude` trong global gitignore),
# trừ cấu hình riêng từng máy và log của hook
!.claude/
.claude/settings.local.json
.claude/logs/

# Cho phép commit artifact triển khai BMAD (global ignore đang chặn _bmad-output/)
!_bmad-output/
_bmad-output/*
!_bmad-output/implementation-artifacts/
